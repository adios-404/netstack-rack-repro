+// enterRACKRecovery reports whether the loss starts a new recovery episode.
+//
+// +checklocks:s.ep.mu
+func (s *sender) enterRACKRecovery() bool {
+	if s.FastRecovery.Active || s.sackRecoveryInterrupted {
+		return false
+	}
+	s.cc.HandleLossDetected()
+	s.enterRecovery()
+	return true
+}
