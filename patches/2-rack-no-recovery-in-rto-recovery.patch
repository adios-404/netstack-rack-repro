+// rackMayEnterRecovery returns true if a loss that RACK detects can start fast
+// recovery.
+//
+// Why: after an RTO, RTO recovery resends the window that the timeout already
+// reacted to in slow start. A new recovery phase must not start until that
+// window is acknowledged (RFC 6675 section 5.1, RFC 6582 section 3.2 steps 2
+// and 4), and losses in one window get one congestion response (RFC 8985
+// section 9.3). Fast recovery here would reduce ssthresh a second time, from
+// the cwnd that slow start has reached since the RTO, and limit the rest of
+// the repair to ssthresh+3 segments.
+//
+// +checklocks:s.ep.mu
+func (s *sender) rackMayEnterRecovery() bool {
+	return !s.FastRecovery.Active && s.state != tcpip.RTORecovery
+}
