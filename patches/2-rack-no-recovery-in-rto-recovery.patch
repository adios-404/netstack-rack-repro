+// rackMayEnterRecovery returns true if a loss detected by RACK may start fast
+// recovery. After an RTO, RTO recovery retransmits the window the timeout
+// already reacted to in slow start, and no new recovery phase may start until
+// that window is acknowledged (RFC 6675 section 5.1, RFC 6582 section 3.2
+// step 4). Entering fast recovery here would reduce ssthresh a second time,
+// from the post-RTO cwnd of 1, and limit the rest of the recovery to a cwnd of
+// ssthresh+3 (RFC 8985 section 9.3: one congestion response per window).
+//
+// +checklocks:s.ep.mu
+func (s *sender) rackMayEnterRecovery() bool {
+	return !s.FastRecovery.Active && s.state != tcpip.RTORecovery
+}
